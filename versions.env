# =============================================================================
# versions.env — Pinned component versions and local compose defaults
#
# Suite semver is derived by CI from git tags (not stored here).
# =============================================================================

# renovate: datasource=github-releases depName=hermes-agent packageName=NousResearch/hermes-agent versioning=loose
AGENT_VERSION=v2026.9.7
# renovate: datasource=github-releases depName=hermes-webui packageName=nesquena/hermes-webui
WEBUI_VERSION=v0.52.113

# Helper scripts: auto | docker | podman
CONTAINER_RUNTIME=auto
USE_SUDO=false

# Opt-in supervised services (same semantics as official hermes-agent)
# Dashboard is upstream s6; WebUI is the suite-added s6 service.
HERMES_DASHBOARD=0
HERMES_WEBUI=0
