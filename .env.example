# Optional local overrides for docker compose / helper scripts.
# Prefer setting these in the environment or Kubernetes manifests.

# Match host UID/GID to volume ownership (official agent stage2 hook)
# HERMES_UID=1000
# HERMES_GID=1000

# Opt-in services (default off — drop-in for official hermes-agent)
# HERMES_DASHBOARD=1
# HERMES_WEBUI=1

# Dashboard basic auth (required when HERMES_DASHBOARD=1 on non-loopback bind)
# HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
# HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=changeme
