#!/command/with-contenv sh
# shellcheck shell=sh
# hermes-webui service. Mirrors upstream docker/s6-rc.d/dashboard:
# always declared so s6 has a supervised slot; if HERMES_WEBUI isn't
# truthy the run script exits cleanly and finish returns 125 (permanent
# failure / do not restart).

case "${HERMES_WEBUI:-}" in
    1|true|TRUE|True|yes|YES|Yes) ;;
    *)
        exit 0
        ;;
esac

# with-contenv repopulates HOME from /init as /root. Reset before drop.
export HOME="${HERMES_HOME:-/opt/data}"

cd /opt/hermes-webui || exit 1

webui_host="${HERMES_WEBUI_HOST:-0.0.0.0}"
webui_port="${HERMES_WEBUI_PORT:-8787}"
export HERMES_WEBUI_HOST="$webui_host"
export HERMES_WEBUI_PORT="$webui_port"
export HERMES_WEBUI_STATE_DIR="${HERMES_WEBUI_STATE_DIR:-/opt/data/webui}"
export HERMES_WEBUI_DEFAULT_WORKSPACE="${HERMES_WEBUI_DEFAULT_WORKSPACE:-/workspace}"
export HERMES_WEBUI_AGENT_DIR="${HERMES_WEBUI_AGENT_DIR:-/opt/hermes}"
export HERMES_HOME="${HERMES_HOME:-/opt/data}"

# Skip the drop when already non-root.
if [ "$(id -u)" != 0 ]; then
    exec /opt/hermes-webui/venv/bin/python /opt/hermes-webui/server.py
fi
exec s6-setuidgid hermes /opt/hermes-webui/venv/bin/python /opt/hermes-webui/server.py
